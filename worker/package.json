{
  "name": "recipe-app-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "db:migrate:local": "wrangler d1 execute recipe-app-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute recipe-app-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.0.0"
  }
}
